<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TARpe24_Mobiilirakendused.LumememmPage"
             Title="LumememmPage">
    <VerticalStackLayout BackgroundColor="LightBlue">

        <AbsoluteLayout HeightRequest="500">

            
            <Frame x:Name="Body"
                   BackgroundColor="White"
                   CornerRadius="100"
                   WidthRequest="150"
                   HeightRequest="150"
                   AbsoluteLayout.LayoutBounds="0.5,0.7,150,150"
                   AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Frame x:Name="Head"
                   BackgroundColor="White"
                   CornerRadius="75"
                   WidthRequest="100"
                   HeightRequest="100"
                   AbsoluteLayout.LayoutBounds="0.5,0.44,100,100"
                   AbsoluteLayout.LayoutFlags="PositionProportional" />
            
            <BoxView x:Name="Bucket"
                    Color="Gray"
                    WidthRequest="80"
                    HeightRequest="60"
                    AbsoluteLayout.LayoutBounds="0.5,0.31,110,60"
                    AbsoluteLayout.LayoutFlags="PositionProportional" />


            <!-- Left Eye -->
            <BoxView x:Name="LeftEye"
                     Color="Black"
                     WidthRequest="10"
                     HeightRequest="10"
                     AbsoluteLayout.LayoutBounds="0.49,0.43,10,10"
                     AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- Right Eye -->
            <BoxView x:Name="RightEye"
                     Color="Black"
                     WidthRequest="10"
                     HeightRequest="10"
                     AbsoluteLayout.LayoutBounds="0.51,0.43,10,10"
                     AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- Buttons -->
            <BoxView  x:Name="Button1"
                      Color="Black"
                      WidthRequest="10"
                      HeightRequest="10"
                      AbsoluteLayout.LayoutBounds="0.5,0.65,10,10"
                      AbsoluteLayout.LayoutFlags="PositionProportional" />

            <BoxView x:Name="Button2" 
                     Color="Black"
                     WidthRequest="10"
                     HeightRequest="10"
                     AbsoluteLayout.LayoutBounds="0.5,0.72,10,10"
                     AbsoluteLayout.LayoutFlags="PositionProportional" />
        </AbsoluteLayout>

        <VerticalStackLayout Padding="20" Spacing="10">

            <Picker x:Name="ActionPicker" Title="Vali tegevus">
                <Picker.Items>
                    <x:String>Peida</x:String>
                    <x:String>Näita</x:String>
                    <x:String>Muuda värvi</x:String>
                    <x:String>Sulata</x:String>
                    <x:String>Tantsi</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Käivita"
                    Clicked="OnActionClicked" />
            <Button Text="Öörežiim"
                Clicked="OnNightModeClicked"/>

            <Label x:Name="ResultLabel"
                   Text="Vali tegevus" />

            <Label Text="Läbipaistvus" />
            <Slider Minimum="0" Maximum="1"
                    ValueChanged="OnSliderChanged" />

            <Label Text="Kiirus" />
            <Stepper Minimum="0.5" Maximum="3" Increment="0.5"
                     ValueChanged="OnStepperChanged"/>

        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>