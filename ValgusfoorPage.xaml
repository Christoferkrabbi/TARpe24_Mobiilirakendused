<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TARpe24_Mobiilirakendused.ValgusfoorPage"
             Title="ValgusfoorPage">
    <VerticalStackLayout Spacing="15" Padding="30" HorizontalOptions="Center">

        <!-- pealkiri -->
        <Label x:Name="statusLabel" 
               Text="Vali valgus" 
               FontSize="24" 
               HorizontalOptions="Center" 
               FontAttributes="Bold" />

        <!-- tuled -->
        <Frame x:Name="PunaneTuli" HeightRequest="100" WidthRequest="100" 
               CornerRadius="50" BackgroundColor="Gray"/>

        <Frame x:Name="KollaneTuli" HeightRequest="100" WidthRequest="100" 
               CornerRadius="50" BackgroundColor="Gray"/>

        <Frame x:Name="RohelineTuli" HeightRequest="100" WidthRequest="100" 
               CornerRadius="50" BackgroundColor="Gray"/>

        <!-- nupud -->
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="Sisse" Clicked="OnSisseClicked" WidthRequest="100" />
            <Button Text="Välja" Clicked="OnValjaClicked" WidthRequest="100" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>